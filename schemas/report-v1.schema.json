{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/appdever01/repo-doctor/schemas/report-v1.schema.json",
  "title": "Repo Doctor report schema 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool_version", "project", "outcome", "complete", "exit_code", "summary", "checks"],
  "properties": {
    "schema_version": {"const": 1},
    "tool_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "project": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "path", "runtimes"],
      "properties": {"name": {"type": "string"}, "path": {"const": "."}, "runtimes": {"type": "array", "uniqueItems": true, "items": {"enum": ["node", "python"]}}}
    },
    "outcome": {"enum": ["passed", "issues_found", "incomplete", "invalid_input", "internal_error"]},
    "complete": {"type": "boolean"},
    "exit_code": {"type": "integer", "minimum": 0, "maximum": 3},
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["pass", "warn", "fail", "skipped", "error"],
      "properties": {"pass": {"$ref": "#/$defs/count"}, "warn": {"$ref": "#/$defs/count"}, "fail": {"$ref": "#/$defs/count"}, "skipped": {"$ref": "#/$defs/count"}, "error": {"$ref": "#/$defs/count"}}
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "status", "finding_code", "message", "evidence", "next_step"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "warn", "fail", "skipped", "error"]},
          "finding_code": {"type": "string", "pattern": "^[a-z_]+\\.[a-z_]+$"},
          "message": {"type": "string"},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["source", "detail"], "properties": {"source": {"type": "string"}, "detail": {"type": "string"}}}},
          "next_step": {"type": ["string", "null"]}
        }
      }
    }
  },
  "$defs": {"count": {"type": "integer", "minimum": 0}}
}
